        <member name="M:ClassifiedAds.Api.Controllers.DynamicAdsController.CreateAdMultipart(System.String,System.String,ClassifiedAds.Application.DTOs.Ads.CreateAdDto)">
            <summary>
            Create an ad for any category using multipart/form-data with file uploads
            </summary>
            <param name="lang">Language code (ar or kr)</param>
            <param name="categorySlug">Full category path slug</param>
            <param name="formDto">Ad data from form fields</param>
            <returns>Created ad ID</returns>
            <remarks>
            Example: POST /api/ar/categories/مركبات-ونقل/سيارات/ads
            Content-Type: multipart/form-data
            Form Fields: Title, Description, PriceValue, PriceIsDollar, City, Region, Neighborhood, Street, ImageFiles (files)
            </remarks>
        </member>
        <member name="M:ClassifiedAds.Api.Controllers.DynamicAdsController.GetAdById(System.String,System.String,System.String)">
            <summary>
            Get ad by ID
            </summary>
            <remarks>
            Example: GET /api/ar/بغداد/ads/507f1f77bcf86cd799439011
            </remarks>
        </member>
        <member name="M:ClassifiedAds.Api.Controllers.DynamicAdsController.UpdateAd(System.String,System.String,System.Text.Json.JsonElement)">
            <summary>
            Update ad by ID
            </summary>
            <remarks>
            Example: PUT /api/ar/ads/507f1f77bcf86cd799439011
            </remarks>
        </member>
        <member name="M:ClassifiedAds.Api.Controllers.DynamicAdsController.DeleteAd(System.String,System.String)">
            <summary>
            Delete ad by ID
            </summary>
            <remarks>
            Example: DELETE /api/ar/ads/507f1f77bcf86cd799439011
            </remarks>
        </member>
